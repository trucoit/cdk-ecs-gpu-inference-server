{
  "name": "cdk-ecs-gpu-inference-server",
  "version": "0.1.0",
  "description": "Modular CDK (TypeScript) constructs for running GPU inference servers on Amazon ECS Managed Instances, in queue (async) or API (online) mode",
  "private": true,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint . && prettier --check .",
    "lint:fix": "eslint . --fix && prettier --write .",
    "test": "jest"
  },
  "peerDependencies": {
    "aws-cdk-lib": "^2.219.0",
    "constructs": "^10.3.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.0",
    "@types/node": "^22.0.0",
    "aws-cdk-lib": "^2.219.0",
    "cdk-nag": "^2.35.0",
    "constructs": "^10.3.0",
    "eslint": "^9.9.0",
    "eslint-config-prettier": "^9.1.0",
    "jest": "^29.7.0",
    "prettier": "^3.3.0",
    "ts-jest": "^29.2.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.2.0"
  },
  "allowScripts": {
    "fsevents@2.3.3": true
  }
}
